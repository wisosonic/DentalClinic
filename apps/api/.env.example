NODE_ENV=development
PORT=4000

# sqlite for development; mysql (MariaDB/MySQL) later: set DB_CLIENT=mysql and the DB_* values below
DB_CLIENT=sqlite
DB_FILENAME=./data/dental_clinic.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=dental_clinic

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Clinic rules (doctors have no fixed hours, so there are no working-day or slot settings)
# CLINIC_TIMEZONE=Asia/Beirut
# CANCEL_MIN_HOURS=24         # patients can cancel online only this far ahead

UPLOAD_DIR=./data/uploads
# Comma-separated list. Not needed for the web dev server (it proxies /api).
CORS_ORIGIN=http://localhost:5180
# Used in reset links: set to the address people really open (for example http://192.168.18.183:5180).
APP_URL=http://localhost:5180
# COOKIE_SECURE defaults to true in production
# BCRYPT_COST=12
# TRUST_PROXY=true   # when behind a reverse proxy
